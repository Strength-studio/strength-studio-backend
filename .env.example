NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
DASHBOARD_ORIGIN=http://localhost:3001
POSTGRES_PORT=5434
POSTGRES_PASSWORD=local-migrator-only
STUDIO_API_PASSWORD=local-api-only
DATABASE_URL=postgresql://studio_api:local-api-only@127.0.0.1:5434/strength_studio?schema=public&connection_limit=4
MIGRATION_DATABASE_URL=postgresql://postgres:local-migrator-only@127.0.0.1:5434/strength_studio?schema=public
AUTH_SIGNING_KEY=replace-with-output-of-openssl-rand-hex-32

# Next.js server environment. Keep the CSRF key distinct from the API signing key.
API_BASE_URL=http://127.0.0.1:3000
DASHBOARD_CSRF_KEY=replace-with-output-of-a-separate-openssl-rand-hex-32
